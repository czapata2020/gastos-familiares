# Copiar como .env en el Droplet (/opt/gastos/.env). Nunca subir .env al repo.

# Versión de la imagen a desplegar (latest o sha-xxxxxxx para fijar/rollback)
TAG=latest

# ── Cloudflare ────────────────────────────────────────────────────────────────
# Zero Trust → Networks → Tunnels → (tu túnel) → token del comando "cloudflared tunnel run --token ..."
CLOUDFLARE_TUNNEL_TOKEN=
# Zero Trust → Settings → Custom Pages: "Team domain" (ej. cuentasclaras.cloudflareaccess.com)
CF_ACCESS_TEAM_DOMAIN=
# Zero Trust → Access → Applications → (la app) → Overview → "Application Audience (AUD) Tag"
CF_ACCESS_AUD=
# Segunda barrera: mismos correos que la política de Access
ALLOWED_EMAILS=cesarzapata24@gmail.com,rpalominom16@gmail.com

# URL pública (para el enlace en los correos)
APP_URL=https://app.cuentasclaras.stream

# ── Recordatorios por correo (opcional; se activan en Ajustes) ───────────────
# Con Gmail: contraseña de aplicación en https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── WhatsApp Cloud API (bot) ──────────────────────────────────────────────────
# developers.facebook.com → tu app → WhatsApp → Configuración de la API (número +51, no el de prueba)
WHATSAPP_PHONE_NUMBER_ID=
# Business Settings → Usuarios del sistema → token permanente (whatsapp_business_messaging + management)
WHATSAPP_TOKEN=
# App → Configuración → Básica → Clave secreta de la app
WHATSAPP_APP_SECRET=
# Texto que inventamos nosotros; se pega igual en Meta al registrar el webhook
WHATSAPP_VERIFY_TOKEN=
